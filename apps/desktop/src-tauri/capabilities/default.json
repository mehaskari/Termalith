{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core runtime plus the terminal commands only. No shell, filesystem or process plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close"
  ]
}
