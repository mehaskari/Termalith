{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core runtime plus terminal, SSH and saved-session commands. No shell, filesystem or process plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-ssh-open",
    "allow-host-key-respond",
    "allow-app-info",
    "allow-sessions-list",
    "allow-session-create",
    "allow-session-update",
    "allow-session-delete",
    "allow-session-forget-secret",
    "allow-sftp-home",
    "allow-sftp-list",
    "allow-sftp-download",
    "allow-sftp-upload",
    "allow-transfer-cancel",
    "allow-known-host-forget",
    "allow-ssh-config-preview",
    "allow-ssh-config-import"
  ]
}
