{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core runtime plus terminal, SSH and saved-session commands. No shell, filesystem or process plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-terminal-split",
    "allow-terminal-log-start",
    "allow-terminal-log-stop",
    "allow-terminal-log-status",
    "allow-tunnel-start",
    "allow-tunnel-list",
    "allow-tunnel-stop",
    "allow-serial-ports",
    "allow-serial-open",
    "allow-net-tcp-check",
    "allow-net-dns-lookup",
    "allow-net-probe-start",
    "allow-net-probe-cancel",
    "allow-ssh-open",
    "allow-desktop-clients",
    "allow-desktop-open",
    "allow-desktop-list",
    "allow-desktop-close",
    "allow-host-key-respond",
    "allow-app-info",
    "allow-sessions-list",
    "allow-session-create",
    "allow-session-update",
    "allow-session-delete",
    "allow-session-forget-secret",
    "allow-sftp-home",
    "allow-sftp-list",
    "allow-sftp-download",
    "allow-sftp-upload",
    "allow-transfer-cancel",
    "allow-known-host-forget",
    "allow-ssh-config-preview",
    "allow-ssh-config-import",
    "allow-settings-get",
    "allow-settings-save",
    "allow-session-set-favorite",
    "allow-sessions-export",
    "allow-sessions-import",
    "allow-snippets-list",
    "allow-snippet-create",
    "allow-snippet-update",
    "allow-snippet-delete"
  ]
}
